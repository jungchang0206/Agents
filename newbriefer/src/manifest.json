{
    "manifest_version": "1.0",
    "display_name": "News Briefer",
    "description": "Fetch top news headlines by category or keyword, and summarize individual articles.",
    "mcp": {
        "endpoint": "{{mcp_endpoint}}",
        "protocol_version": "1.0"
    },
    "tools": [
        {
            "name": "get_news_briefing",
            "description": "Fetch top news headlines filtered by category, country, or keyword query.",
            "input_schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "Optional keyword(s) to search news for (e.g. \"AI\", \"climate change\")."
                    },
                    "category": {
                        "type": "string",
                        "enum": [
                            "business",
                            "entertainment",
                            "general",
                            "health",
                            "science",
                            "sports",
                            "technology"
                        ],
                        "description": "News category. Default: \"general\". Options: business, entertainment, general, health, science, sports, technology."
                    },
                    "country": {
                        "type": "string",
                        "enum": [
                            "us",
                            "gb",
                            "au",
                            "ca",
                            "in",
                            "de",
                            "fr",
                            "jp",
                            "cn",
                            "br"
                        ],
                        "description": "Two-letter country code. Default: \"us\". Options: us, gb, au, ca, in, de, fr, jp, cn, br."
                    },
                    "count": {
                        "type": "number",
                        "description": "Number of articles to return (1–20). Default: 5."
                    }
                },
                "required": []
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "category": {
                        "type": "string"
                    },
                    "country": {
                        "type": "string"
                    },
                    "total_results": {
                        "type": "number"
                    },
                    "returned": {
                        "type": "number"
                    },
                    "articles": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "rank": {
                                    "type": "number"
                                },
                                "title": {
                                    "type": "string"
                                },
                                "source": {
                                    "type": "string"
                                },
                                "author": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "published_at": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "description": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "url": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "image_url": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            }
                        }
                    },
                    "source": {
                        "type": "string",
                        "const": "news_briefer"
                    }
                }
            }
        },
        {
            "name": "summarize_article",
            "description": "Fetch a news article by URL and return an extractive summary of the first N sentences.",
            "input_schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string",
                        "description": "The full URL of the news article to summarize."
                    },
                    "max_sentences": {
                        "type": "number",
                        "description": "Maximum number of sentences to include in the summary (1–10). Default: 4."
                    }
                },
                "required": [
                    "url"
                ]
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string"
                    },
                    "word_count": {
                        "type": "number"
                    },
                    "sentence_count": {
                        "type": "number"
                    },
                    "summary_sentences": {
                        "type": "number"
                    },
                    "summary": {
                        "type": "string"
                    },
                    "source": {
                        "type": "string",
                        "const": "news_briefer"
                    }
                }
            }
        }
    ],
    "provenance": {
        "publisher": "News Briefer",
        "publisher_type": "independent",
        "upstream": [
            "newsapi.org"
        ],
        "verified_owner": false
    },
    "limits": {
        "rate_limit_per_minute": 30
    },
    "agent": "{{hostname}}"
}