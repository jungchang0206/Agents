{
    "manifest_version": "1.0",
    "display_name": "Word Counter",
    "description": "Count words, characters, sentences, and paragraphs in text.",
    "mcp": {
        "endpoint": "https://wordcounter.jungchang02062004.workers.dev/v1/mcp/tools/call",
        "protocol_version": "1.0"
    },
    "tools": [
        {
            "name": "count_words",
            "description": "Count words, characters, sentences, and paragraphs in the provided text.",
            "input_schema": {
                "type": "object",
                "properties": {
                    "text": {
                        "type": "string",
                        "description": "The text to analyze"
                    }
                },
                "required": [
                    "text"
                ]
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "word_count": {
                        "type": "number"
                    },
                    "character_count": {
                        "type": "number"
                    },
                    "character_count_no_spaces": {
                        "type": "number"
                    },
                    "sentence_count": {
                        "type": "number"
                    },
                    "paragraph_count": {
                        "type": "number"
                    },
                    "source": {
                        "type": "string",
                        "const": "word_counter"
                    }
                }
            }
        }
    ],
    "provenance": {
        "publisher": "Jung Chang",
        "publisher_type": "independent",
        "upstream": [],
        "verified_owner": false
    },
    "limits": {
        "rate_limit_per_minute": 60
    },
    "agent": "wordcounter.jungchang02062004.workers.dev"
}